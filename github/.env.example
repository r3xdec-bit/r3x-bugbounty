# ==============================================================================
# R3X-BugBounty Configuration Environment Template
# Note: Use 'r3x mixer add <provider>' for secure encrypted local storage.
# ==============================================================================

# Framework Settings
R3X_HOME=~/.r3x
R3X_LOG_LEVEL=INFO

# Network Defaults
R3X_TIMEOUT_SECONDS=15
R3X_RATE_LIMIT_PER_SEC=5
R3X_MAX_CONCURRENCY=4

# Integrations Endpoints
HERMES_ENDPOINT=http://127.0.0.1:8686
HEXSTRIKE_ENDPOINT=http://127.0.0.1:8888

# Optional Environment Overrides (Prefer 'r3x mixer add' for encrypted keys)
# NVIDIA_API_KEY=nvapi-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
